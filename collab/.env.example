# EPSILON Collaboration Server — Environment Variables
# Copy this file to .env and fill in the values.

# Port the WebSocket server listens on (default 1234)
COLLAB_PORT=1234

# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (publishable) key — used only to init the client
SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (SECRET).
# Used ONLY server-side to verify workspace membership.
# NEVER expose this to the browser. Keep it in the server environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
